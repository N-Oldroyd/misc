{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 1000,
  "height": 500,
  "title": {
    "text": "Shrill Carder Bee Population",
    "font": "Times New Roman",
    "fontSize": 10,
    "fontWeight": "normal",
    "subtitle": "Source: idk",
    "subtitleFont": "Times New Roman",
    "subtitleFontSize": 8,
    "dx": 0,
    "dy": 0,
    "anchor": "middle"
  },
  "layer": [
    {
      "data": {
            "url": "https://raw.githubusercontent.com/N-Oldroyd/misc/refs/heads/main/nuts_bella.json",
            "format": {"type": "json", "property": "features"}
          },
      "projection": {
        "type": "equalEarth"
      },
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "lightgray"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/N-Oldroyd/misc/refs/heads/main/df2-4.csv",
        "format": {"type": "csv"}
      },
      
      "projection": {
        "type": "equalEarth"
      },
      "transform":[
        {
          "calculate": "toNumber(datum.site_count)", "as": "site_num"
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "shape": "M 1,0 L 0.5,0.866025 L -0.5,0.866025 L -1,0 L -0.5,-0.866025 L 0.5,-0.866025 Z",
        "size": 20,
        "stroke": "white",
        "strokeWidth": 0.1,
        "opacity" : 1
      },
      "encoding": {
        "longitude": {
          "field": "long",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        
        "color": {
          "field": "Year_Bin",
          "scale": {"scheme": "yellowgreenblue", "reverse":false},
          "legend": {
            "symbolOpacity": 1,
            "title": "Years",
            "titleFont": "Times New Roman",
            "titleFontSize": 10,
            "titleFontWeight": "normal",
            "titleAnchor": "start",
            "labelFont": "Times New Roman",
            "labelFontSize": 10,
            "orient": "right"
          }
      },
      "size": {
            "field": "site_num",
            "type": "quantitative",
            "legend": {
              "values":[
                1, 20, 40, 60, 80
              ],
              "symbolFillColor": "#1F4A9B",
              "symbolStrokeColor": "#1F4A9B",
              "symbolOpacity": 1,
              "title": "Observations",
              "titleFont": "Times New Roman",
              "titleFontSize": 10,
              "titleFontWeight": "normal",
              "titleAnchor": "start",
              "labelFont": "Times New Roman",
              "labelFontSize": 10,
              "orient": "right"
            },
            "scale": {"range": [1,500]}
          },
          "tooltip": [
            {"field": "SiteName"},
            {"field": "established"}
            
          ],
          "order": {
            "field": "site_num",
            "type": "nominal",
            "sort": "descending"
          } 
      }
    }
  ]
}